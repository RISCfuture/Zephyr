    "Hold every notification, including sync errors, until the snooze ends." : {
      "comment" : "A description of the snooze feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hält alle Mitteilungen, auch Synchronisierungsfehler, zurück, bis die Stummschaltung endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Retiene todas las notificaciones, incluidos los errores de sincronización, hasta que termine el silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Masquez toutes les notifications, erreurs de synchronisation comprises, jusqu’à la fin de la mise en sourdine."
          }
        }
      }
    },
    "Hold every transfer until you resume. Files already on this Mac stay put." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hält alle Übertragungen an, bis du sie fortsetzt. Dateien, die sich bereits auf diesem Mac befinden, bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
