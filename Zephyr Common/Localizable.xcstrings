          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Suspendez tous les transferts jusqu’à la reprise. Les fichiers déjà présents sur ce Mac restent en place."
          }
        }
      }
    },
    "Holds every Zephyr notification, including sync errors, until the snooze ends. Syncing itself carries on." : {
