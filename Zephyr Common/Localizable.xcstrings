    "Stop Zephyr. Finder stops hearing about remote changes until you open it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beende Zephyr. Der Finder erfährt erst wieder von Änderungen aus der Ferne, wenn du Zephyr erneut öffnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
