            "value" : "Zephyr aparece en esa lista cuando se vincula una cuenta; vuelve primero al paso anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zephyr apparaît dans cette liste dès qu’un compte est associé ; revenez d’abord à l’étape précédente."
          }
        }
      }
    },
    "Zephyr can’t install this itself. Run this in Terminal:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zephyr kann dies nicht selbst installieren. Führe im Terminal Folgendes aus:"
