    "Finder hears about changes made elsewhere within seconds — but only while Zephyr is running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Finder erfährt innerhalb von Sekunden von Änderungen, die anderswo vorgenommen wurden – aber nur, solange Zephyr läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El Finder se entera en pocos segundos de los cambios hechos en otro lugar, pero solo mientras Zephyr esté en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le Finder est informé en quelques secondes des modifications effectuées ailleurs, mais uniquement tant que Zephyr est en cours d’exécution."
          }
        }
      }
    },
    "Finder learns about remote changes within seconds only while Zephyr is allowed to open at login." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Der Finder erfährt nur dann innerhalb von Sekunden von Änderungen aus der Ferne, wenn Zephyr bei der Anmeldung geöffnet werden darf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "El Finder solo se entera en pocos segundos de los cambios remotos si Zephyr tiene permiso para abrirse al iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le Finder n’est informé en quelques secondes des modifications distantes que si Zephyr est autorisé à s’ouvrir à l’ouverture de session."
          }
        }
      }
    },
