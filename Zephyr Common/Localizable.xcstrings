      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Setze die Übertragungen fort."
          }
        }
      }
    },
    "Status" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Status"
          }
        }
      }
    },
    "Stop Keeping" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nicht mehr behalten"
          }
        }
      }
    },
    "Stop Zephyr. Finder stops hearing about remote changes until you open it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beende Zephyr. Der Finder erfährt erst wieder von Änderungen aus der Ferne, wenn du Zephyr erneut öffnest."
          }
        }
      }
    },
    "Stops or starts syncing for every Dropbox account Zephyr is keeping in Finder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hält die Synchronisierung aller Dropbox-Konten, die Zephyr im Finder bereitstellt, an oder setzt sie fort."
          }
        }
      }
    },
    "Sync Issues" : {
      "comment" : "A window that shows a list of sync issues.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
