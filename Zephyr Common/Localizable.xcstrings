    "Saves a report of Zephyr’s accounts, sync failures, and recent activity, then shows it in Finder. It names files from your Dropbox, so read it before you send it." : {
      "comment" : "A description of the troubleshooting section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sichert einen Bericht über die Konten von Zephyr, Synchronisierungsfehler und die letzten Aktivitäten und zeigt ihn dann im Finder an. Er nennt Dateien aus deiner Dropbox, also lies ihn durch, bevor du ihn sendest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Enregistre un rapport sur les comptes de Zephyr, les échecs de synchronisation et l’activité récente, puis l’affiche dans le Finder. Il mentionne des fichiers de votre Dropbox ; relisez-le avant de l’envoyer."
          }
        }
      }
    },
    "Settings…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
