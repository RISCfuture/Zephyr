// Template for Config/Secrets.xcconfig (which is gitignored).
//
// You only need this file to build Zephyr against your own Dropbox app
// registration. The default key in Zephyr.xcconfig works out of the box.
//
// Register a Dropbox app at https://www.dropbox.com/developers/apps (Scoped
// access, Full Dropbox), enable the scopes listed in DropboxAppCredentials.swift,
// then copy this file to Secrets.xcconfig and fill in your key.
//
// There is deliberately no app-secret setting: Zephyr authenticates as a public
// client with PKCE, so no client secret is ever sent or built into any product.
DROPBOX_APP_KEY = your_app_key_here
