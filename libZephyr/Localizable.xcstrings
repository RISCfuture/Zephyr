    },
    "%@ has %@ files in %@ folders, with %@ sync issues." : {
      "comment" : "A summary of a Dropbox account's sync state. The first argument is the account name. The second and third arguments are the number of files and folders. The fourth argument is the number of sync issues.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ enthält %2$@ Dateien in %3$@ Ordnern, mit %4$@ Synchronisierungsproblemen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has %2$@ files in %3$@ folders, with %4$@ sync issues."
          }
        }
      }
    },
